#!/bin/bash
set -e

cd $PROJECT_ROOT

source env.sh

PASS=0
FAIL=0

run_test() {
	local name="$1"
	shift
	echo -n "  $name ... "
	if output=$("$@" 2>&1); then
		echo "PASS"
		PASS=$((PASS + 1))
	else
		echo "FAIL"
		echo "$output" | head -30
		FAIL=$((FAIL + 1))
	fi
}

# ── Prerequisites ──────────────────────────────────────

# Quick check: can we reach the vision API? The Anthropic SDK appends
# /v1/messages to BROWSER_TOOL_VISION_BASE_URL, so the models endpoint
# is at ${BASE}/v1/models.
VISION_AVAILABLE=0
if models_json=$(curl -sf --max-time 3 "${BROWSER_TOOL_VISION_BASE_URL:-http://localhost:4000/flex}/v1/models" 2>/dev/null); then
	if echo "$models_json" | python3 -c "import sys,json; d=json.load(sys.stdin); assert len(d.get('data',[]))>0" 2>/dev/null; then
		VISION_AVAILABLE=1
		echo "Vision API available at ${BROWSER_TOOL_VISION_BASE_URL:-http://localhost:4000/flex}"
	fi
fi
if [ "$VISION_AVAILABLE" = "0" ]; then
	echo "WARNING: Vision API not available — e2e eval (vision step) will be skipped"
fi

# ── Library entrypoint (eval/e2e.ts) ──────────────────

echo ""
echo "=== Library entrypoint (eval/e2e.ts) ==="

if [ "$VISION_AVAILABLE" = "1" ]; then
	run_test "e2e eval (full, includes vision)" bun run eval/e2e.ts
else
	# Run unit tests as a sanity check that the library works without vision
	run_test "unit tests (no vision API)" bun test --timeout 30000 --parallel
	echo "  Skipping full e2e eval (vision API unavailable)"
fi

# ── CLI entrypoint ─────────────────────────────────────

echo ""
echo "=== CLI entrypoint ==="

run_test "navigate via CLI" bash -c '
	output=$(bun run src/cli/main.ts navigate --url https://example.com --task-id cli-integration 2>/dev/null)
	echo "$output" | python3 -c "
import sys, json
data = json.load(sys.stdin)
assert data[\"success\"] == True, f\"navigate failed: {data}\"
assert \"snapshot\" in data
assert \"title\" in data
"
'

run_test "snapshot via CLI" bash -c '
	output=$(bun run src/cli/main.ts snapshot --task-id cli-integration 2>/dev/null)
	echo "$output" | python3 -c "
import sys, json
data = json.load(sys.stdin)
assert data[\"success\"] == True, f\"snapshot failed: {data}\"
assert \"snapshot\" in data
"
'

run_test "CLI bad action exits 2" bash -c '
	bun run src/cli/main.ts badaction 2>/dev/null; exit_code=$?
	[ "$exit_code" = "2" ]
'

# ── MCP server entrypoint ──────────────────────────────

echo ""
echo "=== MCP server entrypoint ==="

run_test "initialize + tools/list (10 tools)" bash -c '
	output=$(echo "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0.0.1\"}}}
{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}
{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}" | bun run src/mcp/server.ts 2>/dev/null)

	echo "$output" | python3 -c "
import sys, json
for line in sys.stdin:
	line = line.strip()
	if not line:
		continue
	try:
		obj = json.loads(line)
		if obj.get(\"id\") == 2:
			tools = obj[\"result\"][\"tools\"]
			assert len(tools) == 10, f\"expected 10 tools, got {len(tools)}\"
			names = sorted([t[\"name\"] for t in tools])
			expected = sorted([\"browser_back\",\"browser_click\",\"browser_console\",\"browser_get_images\",\"browser_navigate\",\"browser_press\",\"browser_scroll\",\"browser_snapshot\",\"browser_type\",\"browser_vision\"])
			assert names == expected, f\"tool names mismatch: {names}\"
			sys.exit(0)
	except json.JSONDecodeError:
		continue
print(\"FAIL: never got tools/list response\")
sys.exit(1)
"
'

# ── Summary ────────────────────────────────────────────

echo ""
echo "================================"
echo "  PASS: $PASS  FAIL: $FAIL"
echo "================================"

[ "$FAIL" -eq 0 ]
