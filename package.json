{
  "name": "browser-tool",
  "version": "0.1.0",
  "description": "Standalone Bun + TypeScript port of the local Chromium browser tool. Library + CLI + MCP server.",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "bin": {
    "browser-tool": "src/cli/main.ts",
    "browser-tool-mcp": "src/mcp/server.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun test --timeout 30000 --parallel",
    "eval": "bun run eval/e2e.ts",
    "mcp": "bun run src/mcp/server.ts",
    "cli": "bun run src/cli/main.ts",
    "daemon": "bun run src/daemon.ts",
    "typecheck": "tsc --noEmit",
    "install-chromium": "bunx playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright-core": "^1.50.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
